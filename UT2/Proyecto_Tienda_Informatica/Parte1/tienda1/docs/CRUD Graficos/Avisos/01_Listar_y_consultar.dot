		I [label="Navegador: mostrar tabla" color="#518BC4" fillcolor="#FFFFFF" tooltip="Navegador: mostrar tabla"]
		J [label="Pulsar Ver: GET /admin/avisos/id" color="#518BC4" fillcolor="#FFFFFF" tooltip="Pulsar Ver: GET /admin/avisos/id"]
		P [label="Navegador: mostrar contenido del\naviso" color="#518BC4" fillcolor="#FFFFFF" tooltip="Navegador: mostrar contenido del aviso"]
	}
	subgraph cluster_framework {
		color="#8797B1" fillcolor="#F1F4F8" fontcolor="#63748C" fontname="DejaVu Sans" fontsize=16 label="LARAVEL · RUTAS Y MIDDLEWARE" margin=16 penwidth=2 style="rounded,filled"
		B [label="Laravel: entrada, rutas y\nmiddleware web" color="#8797B1" fillcolor="#FFFFFF" tooltip="Laravel: entrada, rutas y middleware web"]
		K [label="Route Model Binding: buscar Aviso\npor id" color="#8797B1" fillcolor="#FFFFFF" tooltip="Route Model Binding: buscar Aviso por id"]
		L [label="¿Existe el aviso?" color="#8797B1" fillcolor="#FFFFFF" margin="0.2,0.1" shape=diamond style=filled tooltip="¿Existe el aviso?"]
		M [label="Laravel responde con 404" color="#8797B1" fillcolor="#FFFFFF" tooltip="Laravel responde con 404"]
	}
	subgraph cluster_controlador {
		color="#54A17A" fillcolor="#E8F6EE" fontcolor="#28754E" fontname="DejaVu Sans" fontsize=16 label="C · CONTROLADOR" margin=16 penwidth=2 style="rounded,filled"
		C [label="AvisoController.index" color="#54A17A" fillcolor="#FFFFFF" tooltip="AvisoController.index"]
		N [label="AvisoController.show" color="#54A17A" fillcolor="#FFFFFF" tooltip="AvisoController.show"]
	}
	subgraph cluster_modelo {
