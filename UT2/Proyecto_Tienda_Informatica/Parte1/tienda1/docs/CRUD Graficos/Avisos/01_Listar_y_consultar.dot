	}
	subgraph cluster_vista {
		color="#A579D0" fillcolor="#F4EAFF" fontcolor="#7648A4" fontname="DejaVu Sans" fontsize=16 label="V · VISTA" margin=16 penwidth=2 style="rounded,filled"
		G [label="Blade:\nadmin/avisos/index.blade.php" color="#A579D0" fillcolor="#FFFFFF" tooltip="Blade: admin/avisos/index.blade.php"]
		H [label="Layouts admin y app: HTML con\ntabla, acciones y Volver" color="#A579D0" fillcolor="#FFFFFF" tooltip="Layouts admin y app: HTML con tabla, acciones y Volver"]
