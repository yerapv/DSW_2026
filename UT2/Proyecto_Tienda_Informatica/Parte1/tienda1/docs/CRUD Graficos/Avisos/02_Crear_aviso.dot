		I [label="Rechazar petición: 419" color="#8797B1" fillcolor="#FFFFFF" tooltip="Rechazar petición: 419"]
		M [label="Laravel redirige al formulario\ncon errores y valores anteriores" color="#8797B1" fillcolor="#FFFFFF" tooltip="Laravel redirige al formulario con errores y valores anteriores"]
